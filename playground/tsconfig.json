{
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.gts"],
  "compilerOptions": {
    "noUnusedLocals": false,
    "experimentalDecorators": true,
    "types": ["ember-source/types", "vite/client"],
    "paths": {
      "tests/*": ["../vendor/ui/tests/*"],
      "@ui-sdk/core": ["./node_modules/@ui-sdk/core"],
      "@ui-sdk/core/menu": ["./node_modules/@ui-sdk/core/dist/components/menu/menu.d.ts"],
      "@ui-sdk/core/toast": ["./node_modules/@ui-sdk/core/dist/components/toast/toast.d.ts"]
    }
  }
}
