{
  "name": "ui-sdk-ember-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter ember-ui-sdk build",
    "prepare": "pnpm build",
    "dev": "pnpm --filter playground dev",
    "test:upstream": "playwright test -c playwright.upstream.config.ts",
    "test:site": "playwright test -c playwright.site.config.ts",
    "pack:local": "pnpm --filter ember-ui-sdk pack --out artifacts/ember-ui-sdk.tgz",
    "test:package": "pnpm pack:local && node --test tests/package.test.mjs && npm --prefix test-app ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund && npm --prefix test-app run test:packed",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^2.29.0",
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "typescript": "~5.9.3"
  }
}
