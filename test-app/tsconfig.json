{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "types": ["ember-source/types"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["smoke.gts"]
}
